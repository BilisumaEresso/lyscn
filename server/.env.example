PORT=5000
NODE_ENV=development

# Database (required in production)
MONGO_URI=your_mongodb_connection_string

# Auth secrets — use 64+ random hex chars in production (see README)
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret

# CORS — required in production (exact frontend URLs, no trailing slash)
CLIENT_URL_CUSTOMER=http://localhost:5173
CLIENT_URL_DASHBOARD=http://localhost:5174
ALLOWED_ORIGINS=

# Image uploads (required if staff upload menu/restaurant images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (optional — defaults shown in DEPLOYMENT.md)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_PUBLIC_TABLE_MAX=120
# RATE_LIMIT_PUBLIC_WRITE_MAX=60
# RATE_LIMIT_DISABLED=false
